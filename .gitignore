# ─── Rust / Soroban ─────────────────────────────────────────────────
target/
**/*.rs.bk
Cargo.lock.bak
# WASM compilados (los re-genera cargo build)
*.wasm
# Snapshots auto-generados por testutils (regenera al correr tests)
**/test_snapshots/

# ─── Android / Gradle / Kotlin ──────────────────────────────────────
android/.gradle/
android/build/
android/app/build/
android/captures/
android/.idea/
android/local.properties
android/*.iml
android/.kotlin/
# secretos locales que NUNCA suben (Mapbox sk., API keys)
android/keystore.properties
# solo el de la raíz del repo; android/gradle.properties SÍ se versiona (flags AndroidX, sin secretos)
/gradle.properties

# ─── IDE / SO ───────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# ─── Node / scripts ─────────────────────────────────────────────────
node_modules/
scripts/dist/
scripts/.env
scripts/.env.local

# ─── Outputs locales ────────────────────────────────────────────────
# deployments.json sí versionamos (IDs de contratos públicos en testnet).
# Pero los logs/output locales no:
deployments.local.json
*.log
# Screenshots adb temporales
raiz_screen*.png
# Capturas de debugging (los screenshots "buenos" de android/.shots/ raíz sí se versionan)
# Capturas nuevas de debugging no se versionan por defecto (las 3 de referencia ya trackeadas se mantienen; `git add -f` para añadir otra)
android/.shots/

# ─── Claude Code ────────────────────────────────────────────────────
.claude/settings.local.json
# Vault de stellar-memory (índice de sesiones de agente, regenerable) — no se versiona
.stellar-memory/
# Snapshots/backups locales pendientes de borrar
_to_delete/

# ─── Documentos(toda la carpeta) ────────────────────────────────────────────────────
.docs/

# Worktrees temporales de Claude Code
.claude/worktrees/
