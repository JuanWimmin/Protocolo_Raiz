<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Base: system + user CAs, solo HTTPS. El cert custom de Sectigo
      (necesario para soroban-testnet.stellar.org en algunos OEMs) se
      añade vía SSLContext en RaizApplication.installSecurity(), porque
      Ktor con engine CIO no usa el método hostname-aware del
      TrustManager y eso choca con &lt;domain-config&gt;.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
